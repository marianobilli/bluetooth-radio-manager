  (fp_text value "RADIO" (at 20 3.81 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text user "nRF24 PA/LNA 41x15.5 (solid) / E01-2G4M27D 33.2x18 (dashed), ANT ->" (at 18 6 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
