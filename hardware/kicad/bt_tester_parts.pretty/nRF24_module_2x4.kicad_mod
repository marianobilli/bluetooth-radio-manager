(footprint "nRF24_module_2x4"
  (version 20241229)
  (generator "pcbnew")
  (generator_version "9.0")
  (descr "2x4 2.54mm female socket for a 2.4GHz radio module (nRF24L01+PA/LNA or pin-compatible Ebyte E01-2G4M27D). Standard nRF24L01 pinout (module top view, header at the left end, antenna at the right end): odd column 1 GND, 3 CE, 5 SCK, 7 MISO is the module's outer edge; even column 2 VCC(3V3), 4 CSN, 6 MOSI, 8 IRQ is toward the antenna. The module body (nRF24L01+PA/LNA 41x15.5mm solid, E01-2G4M27D 33.2x18mm dashed, measured, centred on the header) therefore extends in +X from the pins (drawn on F.Fab); place the footprint so +X points off the board edge, with >=18.5mm pitch between sockets so either module fits any slot - the enclosure supports the body and SMA antenna. Origin = pin 1 (GND).")
  (layer "F.Cu")
  (tags "nrf24l01 e01-2g4m27d 2.4ghz radio module socket")
  (attr through_hole)
