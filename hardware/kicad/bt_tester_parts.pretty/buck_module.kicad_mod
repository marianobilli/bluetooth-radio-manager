(footprint "buck_module"
  (version 20241229)
  (generator "pcbnew")
  (generator_version "9.0")
  (layer "F.Cu")
  (descr "3.3V step-down regulator module, one per radio slot, on the same 30 x 17 mm board as the HW-183B module used in plant-watering-system (USB-C input), mounted on 4 corner solder holes and set to 3.3V before fitting: IN+ top-left (1), IN- bottom-left (2), OUT+ top-right (3), OUT- bottom-right (4). Hole centres 2 mm from the module edges (26 x 13 mm spacing). The unused USB-C receptacle overhangs the IN edge by 1.3 mm; the courtyard includes it. Module top (trimmer) is ~15 mm above the board. 1.5mm drills take 0.64mm header pins with margin.")
  (tags "buck step-down module 3v3")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -3 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "BUCK 3V3" (at 0 10.2 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text user "IN+" (at -8.8 -6.5 0) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_text user "IN-" (at -8.8 6.5 0) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_text user "OUT+" (at 8.4 -6.5 0) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_text user "OUT-" (at 8.4 6.5 0) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_text user "set 3V3 first" (at 0 0 0) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_rect (start -15 -8.5) (end 15 8.5) (stroke (width 0.12) (type solid)) (fill no) (layer "F.SilkS"))
  (fp_rect (start -16.45 -8.75) (end 15.15 8.75) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
  (fp_rect (start -15 -8.5) (end 15 8.5) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab"))
  (fp_rect (start -16.3 -4.47) (end -8.15 4.47) (stroke (width 0.1) (type dash)) (fill no) (layer "F.Fab"))
  (pad "1" thru_hole rect (at -13 -6.5) (size 2.4 2.4) (drill 1.5) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at -13 6.5) (size 2.4 2.4) (drill 1.5) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 13 -6.5) (size 2.4 2.4) (drill 1.5) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 13 6.5) (size 2.4 2.4) (drill 1.5) (layers "*.Cu" "*.Mask"))
  (model "${KIPRJMOD}/bt_tester_parts.3dshapes/buck_module.step" (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
